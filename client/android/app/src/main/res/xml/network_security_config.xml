<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-hosted ApexDrive talks to LAN servers over HTTP (e.g. http://192.168.x.x:8090).
  Android network-security-config cannot express RFC1918 CIDR ranges, so cleartext is
  permitted at the base level for this self-hosted client. Prefer HTTPS when available.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
