# Copy to .env and set a strong random value before running in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enable one-way account sync receive (POST /api/sync/account).
# Leave unset on public internet unless you need family sync from a trusted pusher.
# SYNC_TOKEN=change-me-to-a-long-random-sync-token

# Server
PORT=8090
HOST=0.0.0.0
DATA_DIR=/app/data

# Optional: path to SQLite file (default: DATA_DIR/vehicle_tracker.db)
# DB_PATH=/app/data/vehicle_tracker.db
